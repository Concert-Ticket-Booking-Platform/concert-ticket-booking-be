{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Host=${DB_HOST};Port=${DB_PORT};Database=${CONCERT_BOOKING_DB_NAME};Username=${DB_USER};Password=${DB_PASSWORD};Ssl Mode=Disable;Trust Server Certificate=True;"
  },
  "Jwt": {
    "Secret": "${JWT_SECRET}",
    "Issuer": "${JWT_ISSUER}",
    "Audience": "${JWT_AUDIENCE}",
    "ExpiresInHours": "${JWT_EXPIRES_IN_HOURS}"
  },
  "VNPay": {
    "TmnCode": "${VNPAY_TMN_CODE}",
    "HashSecret": "${VNPAY_HASH_SECRET}",
    "BaseUrl": "${VNPAY_BASE_URL}",
    "ReturnUrl": "${VNPAY_RETURN_URL}"
  }
}
